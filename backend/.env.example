# Copy to .env and fill in. Never commit the real .env.

# HTTP port for the API (default 5000)
PORT=5000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ctms_ug
DB_USER=postgres
DB_PASSWORD=

# Required in production. Generate one with:
#   openssl rand -hex 32
#
# If this is unset the server generates an ephemeral key at startup, so
# development works but every restart invalidates existing tokens.
JWT_SECRET=
